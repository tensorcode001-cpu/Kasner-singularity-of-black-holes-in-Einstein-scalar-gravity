Cell[BoxData[{
 RowBox[{"MR1Plot", "=", 
  RowBox[{"ListPlot", "[", 
   RowBox[{"MR1", ",", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\< \!\(\*SubscriptBox[\(r\), \(0\)]\)\>\"", ",", 
         RowBox[{"FontSize", "->", "18"}]}], "]"}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<M\>\"", ",", " ", 
         RowBox[{"FontSize", "->", "18"}]}], "]"}]}], "}"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"MRSPlot", "=", 
  RowBox[{"ListPlot", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Con1", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Con1", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "/", "2"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "total1"}], "}"}]}], "]"}], ",", 
    RowBox[{"Joined", "->", "True"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"%%", ",", "%"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"M\[CapitalSigma]1plot", "=", 
  RowBox[{"ListPlot", "[", 
   RowBox[{"M\[CapitalSigma]1", ",", 
    RowBox[{"AxesLabel", "->", 
