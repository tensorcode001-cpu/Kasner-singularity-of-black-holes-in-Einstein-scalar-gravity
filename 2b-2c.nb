         RowBox[{"FontSize", "->", "18"}]}], "]"}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<\[CapitalSigma]\>\"", ",", " ", 
         RowBox[{"FontSize", "->", "18"}]}], "]"}]}], "}"}]}]}], 
   "]"}]}]}], "Input",
