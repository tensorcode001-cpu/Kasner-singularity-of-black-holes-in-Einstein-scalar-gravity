    RowBox[{"ep", "=", "1"}], ";", 
    RowBox[{"g5", "=", "1"}], ";", 
    RowBox[{"g7", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r0", "=", "1.5"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ri", "=", 
     RowBox[{"r0", " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"1", "/", 
         RowBox[{"10", "^", "5"}]}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rf", "=", 
     RowBox[{"10", "^", "25"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"targetReached", "=", 
     RowBox[{"10", "^", "20"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"minStep", "=", 
     RowBox[{"1", "/", 
      RowBox[{"10", "^", "15"}]}]}], ";"}], "          ", 
   RowBox[{"(*", 
    RowBox[{"\:6700\:5c0f\:6b65\:957f", "\:ff0c", 
     RowBox[{"\:5230", " ", 
      RowBox[{"1", "/", 
       RowBox[{"10", "^", "6"}]}], " ", "\:5c31\:505c"}]}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"\:5b50\:51fd\:6570", "\:ff1a", 
     RowBox[{
      RowBox[{"\:7ed9\:5b9a", "[", 
       RowBox[{"phMin", ",", "phMax"}], "]"}], " ", "\:548c\:6b65\:957f"}], 
     "\:ff0c", 
     RowBox[{"\:8fd4\:56de", " ", 
      RowBox[{"{", 
       RowBox[{"bestPh0", ",", "bestReached"}], "}"}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"scan", "[", 
      RowBox[{"phMin_", ",", "phMax_", ",", "step_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"best", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1."}], ",", "0."}], "}"}]}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{"{", 
         RowBox[{"ph0", ",", "reached"}], "}"}], "*)"}], 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ph0", "=", 
            RowBox[{"SetPrecision", "[", 
             RowBox[{"p", ",", "Infinity"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"res", "=", 
            RowBox[{"Quiet", "@", 
             RowBox[{
              RowBox[{"NDSolve", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"eq1", "==", "0"}], ",", 
                  RowBox[{"eq2", "==", "0"}], ",", 
                  RowBox[{"eq3", "==", "0"}], ",", 
                  RowBox[{
                   RowBox[{"f", "[", "ri", "]"}], "==", 
                   RowBox[{"if", "[", "ri", "]"}]}], ",", 
                  RowBox[{
                   RowBox[{"ph", "[", "ri", "]"}], "==", 
                   RowBox[{"iph", "[", "ri", "]"}]}], ",", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"ph", "'"}], "[", "ri", "]"}], "==", 
                   RowBox[{
                    RowBox[{"iph", "'"}], "[", "ri", "]"}]}], ",", 
                  RowBox[{
                   RowBox[{"h", "[", "ri", "]"}], "==", 
                   RowBox[{"ih", "[", "ri", "]"}]}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"f", ",", "ph", ",", "h"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"r", ",", "ri", ",", "rf"}], "}"}], ",", 
                RowBox[{"AccuracyGoal", "->", "30"}], ",", 
                RowBox[{"PrecisionGoal", "->", "30"}], ",", 
                RowBox[{"WorkingPrecision", "->", "50"}], ",", 
                RowBox[{"MaxSteps", "->", "20000"}]}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"reached", "=", 
            RowBox[{"Quiet", "@", 
             RowBox[{"Check", "[", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Head", "[", 
                   RowBox[{"f", "/.", " ", "res"}], "]"}], "===", 
                  "InterpolatingFunction"}], ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"f", "/.", " ", "res"}], ")"}], "[", 
                   "\"\<Domain\>\"", "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", "0"}], "]"}], 
               ",", "0"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"reached", ">=", "targetReached"}], ",", 
             RowBox[{"Return", "[", 
              RowBox[{"{", 
               RowBox[{"p", ",", "reached"}], "}"}], "]"}]}], "]"}], ";", 
           RowBox[{
           "(*", "\:76f4\:63a5\:8fbe\:6807\:5c31\:63d0\:524d\:9000\:51fa", 
            "*)"}], 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"reached", ">", 
              RowBox[{"best", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ",", 
             RowBox[{"best", "=", 
              RowBox[{"{", 
               RowBox[{"p", ",", "reached"}], "}"}]}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"p", ",", "phMin", ",", "phMax", ",", "step"}], "}"}]}], 
         "]"}], ";", "\[IndentingNewLine]", "best"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "\:4e3b\:5faa\:73af", "\:ff1a", "\:81ea\:9002\:5e94\:6b65\:957f"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"phMin", "=", "0.1"}], ";", 
    RowBox[{"phMax", "=", "0.9"}], ";", 
    RowBox[{"step", "=", 
     RowBox[{"1", "/", "10"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"finalPh0", "=", "Null"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"While", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"step", ">=", "minStep"}], "&&", 
       RowBox[{"finalPh0", "===", "Null"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"bestPh", ",", "bestRe"}], "}"}], "=", 
        RowBox[{"scan", "[", 
         RowBox[{"phMin", ",", "phMax", ",", "step"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<\:6b65\:957f \>\"", ",", "step", ",", 
         "\"\< \:6700\:4f73 ph0 = \>\"", ",", "bestPh", ",", 
         "\"\<  reached = \>\"", ",", "bestRe"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"bestRe", ">=", 
          RowBox[{"targetReached", "/", "10"}]}], ",", 
         RowBox[{
          RowBox[{"finalPh0", "=", "bestPh"}], ";", 
          RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
       "(*", "\:7f29\:5c0f\:8303\:56f4\:5230\:6700\:4f18\:70b9\:9644\:8fd1\
\:4e00\:4e2a\:6b65\:957f\:7a97\:53e3", "*)"}], 
       RowBox[{"phMin", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"0.1", ",", 
          RowBox[{"bestPh", "-", "step"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"phMax", "=", 
        RowBox[{"Min", "[", 
         RowBox[{"0.9", ",", 
          RowBox[{"bestPh", "+", "step"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"step", "=", 
        RowBox[{"step", "/", "10"}]}], ";"}]}], "   ", 
     RowBox[{"(*", "\:8fdb\:5165\:4e0b\:4e00\:7ea7\:7cbe\:5ea6", "*)"}], 
     "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"finalPh0", "=!=", "Null"}], ",", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<\:627e\:5230\:6ee1\:8db3 reached >= 10^24 \:7684 ph0 = \>\"", ",", 
       "finalPh0"}], "]"}], ",", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<\:626b\:5230\:6700\:5c0f\:6b65\:957f \>\"", ",", "minStep"}], 
      "]"}]}], "]"}]}]}]], "Input",
